# Google Apps Script Web App URL that receives RSVP submissions.
# Optional — src/utils/rsvp.ts falls back to the couple's deployed Web App
# URL if this isn't set, so the form works without any .env file present.
# Set this to point the site at a different deployment (e.g. a staging
# copy of the Apps Script / Sheet) without touching code.
VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/AKfycbxUiAHK9WfVNLmCgX4IsZ5Np-B4cRxJa1vAp5hd-lRX43vquJ4u0RDwsdVP8acFZvr0/exec
